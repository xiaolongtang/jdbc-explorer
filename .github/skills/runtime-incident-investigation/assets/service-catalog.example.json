{
  "catalogVersion": 1,
  "services": [
    {
      "name": "orders-service",
      "aliases": [
        "orders",
        "order-api"
      ],
      "workspaceFolder": "orders-service",
      "localRepositoryPath": "/workspace/orders-service",
      "apiPatterns": [
        "/api/orders/**"
      ],
      "errorPatterns": [
        "OrderConfirmationException",
        "InventoryClientTimeout"
      ],
      "ownedTables": [
        "orders.app_order",
        "orders.order_event"
      ],
      "logs": {
        "test": {
          "sshTarget": "test-orders-01",
          "currentLogPath": "/var/log/orders/application.log",
          "archiveLogPath": "/var/log/orders/archive",
          "archiveGlob": "application-*.log.gz",
          "timezone": "Asia/Shanghai"
        },
        "staging": {
          "sshTarget": "staging-orders-01",
          "currentLogPath": "/var/log/orders/application.log",
          "archiveLogPath": "/var/log/orders/archive",
          "archiveGlob": "application-*.log.gz",
          "timezone": "UTC"
        }
      },
      "database": {
        "test": {
          "connection": "orders_test",
          "schemas": [
            "orders"
          ],
          "tables": [
            {
              "name": "orders.app_order",
              "businessKeyColumns": [
                "order_id"
              ],
              "traceColumns": [
                "trace_id"
              ],
              "timeColumns": [
                "created_at",
                "updated_at"
              ],
              "sensitiveColumns": [
                "customer_email"
              ]
            }
          ]
        },
        "staging": {
          "connection": "orders_staging",
          "schemas": [
            "orders"
          ],
          "tables": [
            {
              "name": "orders.app_order",
              "businessKeyColumns": [
                "order_id"
              ],
              "traceColumns": [
                "trace_id"
              ],
              "timeColumns": [
                "created_at",
                "updated_at"
              ],
              "sensitiveColumns": [
                "customer_email"
              ]
            }
          ]
        }
      },
      "downstreamServices": [
        "inventory-service",
        "payment-service"
      ]
    },
    {
      "name": "inventory-service",
      "aliases": [
        "inventory",
        "stock-api"
      ],
      "workspaceFolder": "inventory-service",
      "localRepositoryPath": "/workspace/inventory-service",
      "apiPatterns": [
        "/api/inventory/**",
        "/internal/reservations/**"
      ],
      "errorPatterns": [
        "InsufficientStockException",
        "ReservationConflict"
      ],
      "ownedTables": [
        "inventory.stock_item",
        "inventory.reservation"
      ],
      "logs": {
        "test": {
          "sshTarget": "test-inventory-01",
          "currentLogPath": "/var/log/inventory/application.log",
          "archiveLogPath": "/var/log/inventory/archive",
          "archiveGlob": "application-*.log.gz",
          "timezone": "Asia/Shanghai"
        }
      },
      "database": {
        "test": {
          "connection": "inventory_test",
          "schemas": [
            "inventory"
          ],
          "tables": [
            {
              "name": "inventory.reservation",
              "businessKeyColumns": [
                "reservation_id",
                "order_id"
              ],
              "traceColumns": [
                "trace_id"
              ],
              "timeColumns": [
                "created_at",
                "expires_at"
              ],
              "sensitiveColumns": []
            }
          ]
        }
      },
      "downstreamServices": []
    },
